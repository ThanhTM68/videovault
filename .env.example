# App
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/videovault.db

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/downloads
TEMP_STORAGE_ROOT=./data/temp
THUMBNAIL_STORAGE_ROOT=./data/thumbnails

# Download defaults
DOWNLOAD_MAX_HEIGHT=1080
DOWNLOAD_CONCURRENCY=3

# Google Drive (Phase 08; leave empty until configured)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
