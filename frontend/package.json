    "@vue/test-utils": "~2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  }
}
